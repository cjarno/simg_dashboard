# Application
APP_NAME=SIMG Dashboard
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database (file-based)
DATA_DIR=./data
LOGS_DIR=./logs
STATE_DIR=./.simg_state

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Scraping
SCRAPE_DELAY=2
MAX_CONCURRENT_SCRAPERS=3

# Rate Limiting
RATE_LIMIT_JOBS=100
RATE_LIMIT_SCRAPER=10

# API Keys (optional)
# SEEK_API_KEY=
# LINKEDIN_API_KEY=
